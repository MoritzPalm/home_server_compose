# Home Server Docker Compose Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# =============================================================================
# VPN Configuration (for Gluetun)
# =============================================================================
# VPN provider credentials
OPENVPN_USERNAME=your_vpn_username_here
OPENVPN_PASSWORD=your_vpn_password_here

# =============================================================================
# Notification Services
# =============================================================================
# Discord webhook for Watchtower notifications
DISCORD_TOKEN=your_discord_token_here
DISCORD_WEBHOOKID=your_discord_webhook_id_here

# Grafana Admin Credentials (monitoring/monitoring.yml)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_strong_password_here

# =============================================================================
# API Keys and Tokens
# =============================================================================
# MAM (MyAnonamouse) Session ID for tracker integration
MAM_SESSION_ID=your_mam_session_id_here

# Plex claim token (get from https://www.plex.tv/claim/)
PLEX_CLAIM_TOKEN=claim-your_token_here

# Captcha solver service (options: none, hcaptcha-solver, etc.)
CAPTCHA_SOLVER=none

# =============================================================================
# Database Configuration
# =============================================================================
# Immich database settings
DB_PASSWORD=change_me_strong_password
DB_USERNAME=immich
DB_DATABASE_NAME=immich
DB_DATA_LOCATION=/path/to/immich/database

# =============================================================================
# Storage Paths
# =============================================================================
# Main configuration directory for all services
CONFIG_DIR=/path/to/config
CONFIG_PATH=/path/to/config

# Media storage locations
STORAGE_DIR=/path/to/storage
MEDIA_PATH=/path/to/media
MEDIA_DIR=/path/to/media

# Torrent download directory
TORRENT_PATH=/path/to/torrents
TORRENT_DIR=/path/to/torrents

# Log directory
LOG_DIR=/path/to/logs

# Database directory
DATABASE_DIR=/path/to/databases

# Immich upload location
UPLOAD_LOCATION=/path/to/immich/uploads

# =============================================================================
# Application Versions
# =============================================================================
# Immich version tag (default: release)
IMMICH_VERSION=release

# =============================================================================
# Security Notes
# =============================================================================
# 1. Use strong, unique passwords for all credentials
# 2. Store this file securely with restricted permissions (chmod 600)
# 3. Regularly rotate sensitive credentials
# 4. Never share or commit this file to version control
# 5. Consider using a password manager to generate secure passwords
# 6. For production, consider using Docker Secrets instead of env vars

# =============================================================================
# Recommended Password Complexity
# =============================================================================
# - Minimum 20 characters
# - Mix of uppercase, lowercase, numbers, and special characters
# - Unique for each service
# - Generated using a password manager
# 
# Example generation command:
# openssl rand -base64 32
